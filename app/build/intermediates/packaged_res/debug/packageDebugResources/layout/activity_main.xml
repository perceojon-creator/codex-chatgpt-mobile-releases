<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#212121">

    <!-- MAIN CHAT SCREEN (100% ChatGPT Design) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Top ChatGPT App Bar -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/headerLayout"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#212121"
            android:paddingHorizontal="8dp"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Hamburger Button (Left) -->
            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:srcCompat="@drawable/ic_menu"
                app:tint="#ECECEC"
                android:contentDescription="Abrir Historial"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <!-- Model Title Selector (Center) -->
            <LinearLayout
                android:id="@+id/modelSelectorContainer"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:paddingHorizontal="12dp"
                app:layout_constraintStart_toEndOf="@+id/btnMenu"
                app:layout_constraintEnd_toStartOf="@+id/btnNewChat"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <TextView
                    android:id="@+id/tvModelTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ChatGPT ▾"
                    android:textColor="#ECECEC"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvEffortBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="HIGH"
                    android:textColor="#10A37F"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:background="#1E3326"
                    android:paddingHorizontal="5dp"
                    android:paddingVertical="2dp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- New Chat Icon (Right - Pencil) -->
            <ImageButton
                android:id="@+id/btnNewChat"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:srcCompat="@drawable/ic_edit"
                app:tint="#ECECEC"
                android:contentDescription="Nueva Conversación"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Two Modes Switcher: ChatGPT Normal (Default) vs Codex PC -->
        <LinearLayout
            android:id="@+id/modeToggleContainer"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="#1B1B1B"
            android:padding="3dp"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@+id/headerLayout">

            <!-- Tab 1: ChatGPT Normal (Default on launch) -->
            <TextView
                android:id="@+id/tabModeChatGpt"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="💬 ChatGPT Normal"
                android:textColor="#ECECEC"
                android:background="@drawable/bg_tab_selected"
                android:gravity="center"
                android:textStyle="bold"
                android:textSize="13sp"
                android:clickable="true"
                android:focusable="true" />

            <!-- Tab 2: Codex PC (Activates PC Tools, CWD, Sandbox & SQLite history) -->
            <TextView
                android:id="@+id/tabModeCodex"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="⚡ Codex PC"
                android:textColor="#8E8E8E"
                android:background="@null"
                android:gravity="center"
                android:textStyle="bold"
                android:textSize="13sp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Active Context Bar (Shows CWD and Sandbox Policy when in Codex Mode) -->
        <LinearLayout
            android:id="@+id/activeContextBar"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:background="#1A1A1A"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@+id/modeToggleContainer">

            <TextView
                android:id="@+id/tvActiveCwdIndicator"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📁 C:\Users\Admin\Desktop"
                android:textColor="#79C0FF"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvActivePolicyIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔴 Full Access"
                android:textColor="#FF7B72"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Messages Feed (ChatGPT Style) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMessages"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:paddingHorizontal="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="12dp"
            app:layout_constraintTop_toBottomOf="@+id/activeContextBar"
            app:layout_constraintBottom_toTopOf="@+id/attachmentPreviewBar" />

        <!-- Attachment Preview Bar -->
        <LinearLayout
            android:id="@+id/attachmentPreviewBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#2A2A2A"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:gravity="center_vertical"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@+id/inputContainer">

            <TextView
                android:id="@+id/tvAttachmentIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📄"
                android:textSize="18sp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tvAttachmentName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="archivo.py (12 KB)"
                android:textColor="#ECECEC"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <ImageButton
                android:id="@+id/btnRemoveAttachment"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:srcCompat="@drawable/ic_close"
                app:tint="#8E8E8E"
                android:contentDescription="Eliminar adjunto" />
        </LinearLayout>

        <!-- ChatGPT Floating Input Capsule Container -->
        <LinearLayout
            android:id="@+id/inputContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingBottom="12dp"
            android:paddingTop="4dp"
            android:background="#212121"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- The Authentic ChatGPT Capsule -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#2F2F2F"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingVertical="4dp"
                android:minHeight="50dp">

                <!-- (+) Button for Codex Tools -->
                <ImageButton
                    android:id="@+id/btnPlus"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:srcCompat="@drawable/ic_add"
                    app:tint="#ECECEC"
                    android:contentDescription="Herramientas Codex" />

                <!-- (🌐) 1-Tap Web Search Toggle Button (ChatGPT Style) -->
                <ImageButton
                    android:id="@+id/btnWebSearchToggle"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:srcCompat="@drawable/ic_globe"
                    app:tint="#8E8E8E"
                    android:contentDescription="Alternar búsqueda web en vivo" />

                <!-- Message Input Field -->
                <EditText
                    android:id="@+id/etMessage"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Mensaje a ChatGPT..."
                    android:textColorHint="#8E8E8E"
                    android:textColor="#ECECEC"
                    android:textSize="15sp"
                    android:maxLines="5"
                    android:inputType="textCapSentences|textMultiLine"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="8dp" />

                <!-- Mic Button -->
                <ImageButton
                    android:id="@+id/btnMic"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:srcCompat="@drawable/ic_mic"
                    app:tint="#ECECEC"
                    android:contentDescription="Dictado por voz" />

                <!-- Send Button (Pill Arrow) -->
                <ImageButton
                    android:id="@+id/btnSend"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/ic_send"
                    android:layout_marginStart="4dp"
                    android:contentDescription="Enviar mensaje" />

            </LinearLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- SIDEBAR DRAWER (Exact ChatGPT Mobile History Drawer) -->
    <LinearLayout
        android:id="@+id/navigationDrawer"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#171717"
        android:orientation="vertical"
        android:clickable="true"
        android:focusable="true">

        <!-- Drawer Header with New Chat -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="20dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Codex Desktop"
                    android:textColor="#ECECEC"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvServerDot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="● Online"
                    android:textColor="#10A37F"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- New Chat Button inside Drawer -->
            <LinearLayout
                android:id="@+id/btnDrawerNewChat"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="#212121"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    app:srcCompat="@drawable/ic_edit"
                    app:tint="#10A37F"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nuevo chat"
                    android:textColor="#ECECEC"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#262626" />

        <!-- History Title -->
        <TextView
            android:id="@+id/tvDrawerSectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HISTORIAL"
            android:textColor="#888888"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="6dp" />

        <!-- Conversations RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvDrawerConversations"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingHorizontal="4dp" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#262626" />

        <!-- Drawer Footer: Settings & Info -->
        <LinearLayout
            android:id="@+id/btnDrawerSettings"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="?attr/selectableItemBackground"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                app:srcCompat="@drawable/ic_settings"
                app:tint="#8E8E8E"
                android:layout_marginEnd="12dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Configuración y Conexión"
                android:textColor="#ECECEC"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvDrawerPort"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=":8317"
                android:textColor="#8E8E8E"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>