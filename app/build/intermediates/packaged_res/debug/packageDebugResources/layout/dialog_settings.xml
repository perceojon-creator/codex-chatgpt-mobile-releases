<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_surface">

    <LinearLayout 
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚙ Ajustes de Conexión"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="URL Base del Proxy (PC o Nube):"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etBaseUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/default_base_url"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:backgroundTint="@color/border_color"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="API Key (Local):"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etApiKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/default_api_key"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:backgroundTint="@color/border_color"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="E2B Cloud API Key (Python en Nube sin Docker):"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etE2bApiKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:hint="e2b_..."
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:backgroundTint="@color/border_color"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Configuraciones Rápidas:"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:layout_marginBottom="6dp" />

        <Button
            android:id="@+id/btnPresetPC"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🖥️ Usar IP de mi PC (192.168.1.6:8317)"
            android:backgroundTint="@color/bg_surface_light"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="6dp" />

        <Button
            android:id="@+id/btnPresetEmulator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📱 Usar Emulador Android Studio (10.0.2.2)"
            android:backgroundTint="@color/bg_surface_light"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnTestConnection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🧪 Probar Conexión con Servidor"
            android:backgroundTint="#2E4035"
            android:textColor="@color/brand_green"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/tvConnectionStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:gravity="center"
            android:visibility="gone"
            android:layout_marginBottom="14dp" />

        <Button
            android:id="@+id/btnCheckUpdates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🚀 Buscar Actualización de la App"
            android:backgroundTint="#262626"
            android:textColor="#ECECEC"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btnCancelSettings"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Cancelar"
                android:backgroundTint="@color/bg_surface_light"
                android:textColor="@color/text_secondary"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnSaveSettings"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Guardar"
                android:backgroundTint="@color/brand_green"
                android:textColor="#FFFFFF"
                android:layout_marginStart="6dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>