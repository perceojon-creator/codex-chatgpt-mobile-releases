<?xml version="1.0" encoding="utf-8"?>
<LinearLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/bg_surface"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⚙ Ajustes de Conexión Proxy"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="URL Base del Servidor:"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/etBaseUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/default_base_url"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="API Key (local):"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/etApiKey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/default_api_key"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnPresetPC"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Usar IP de mi PC (192.168.1.6)"
        android:backgroundTint="@color/bg_surface_light"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="6dp" />

    <Button
        android:id="@+id/btnPresetEmulator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Usar Emulador Android Studio (10.0.2.2)"
        android:backgroundTint="@color/bg_surface_light"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnSaveSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Guardar Configuración"
        android:backgroundTint="@color/brand_green"
        android:textColor="#FFFFFF" />

</LinearLayout>
