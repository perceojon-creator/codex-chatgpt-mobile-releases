<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="accent_gold">#F59E0B</color>
    <color name="bg_dark">#171717</color>
    <color name="bg_surface">#212121</color>
    <color name="bg_surface_light">#2a2a2a</color>
    <color name="border_color">#383838</color>
    <color name="brand_green">#10A37F</color>
    <color name="brand_green_dark">#0B8063</color>
    <color name="bubble_assistant">#262626</color>
    <color name="bubble_user">#2d3f35</color>
    <color name="text_primary">#ECECEC</color>
    <color name="text_secondary">#9E9E9E</color>
    <string name="app_name">Codex Mobile</string>
    <string name="default_api_key">local-zcode-key-8317</string>
    <string name="default_base_url">http://192.168.1.6:8317/v1</string>
    <string name="default_model">gpt-5.6-sol</string>
    <string name="hint_input">Escribe o dicta un mensaje…</string>
    <string name="new_chat">Nuevo Chat</string>
    <string name="send">Enviar</string>
    <string name="settings">Ajustes</string>
    <style name="TextAppearance.ChatGPT.Badge" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="TextAppearance.ChatGPT.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">#ECECEC</item>
        <item name="android:lineSpacingExtra">3dp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="TextAppearance.ChatGPT.CardTitle" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#ECECEC</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="TextAppearance.ChatGPT.Code" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">#79C0FF</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="TextAppearance.ChatGPT.Input" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">#ECECEC</item>
        <item name="android:textColorHint">#8E8E8E</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>
    <style name="TextAppearance.ChatGPT.SectionHeader" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">#8E8E8E</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="TextAppearance.ChatGPT.Subtitle" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">#888888</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="TextAppearance.ChatGPT.Tab" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="TextAppearance.ChatGPT.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">#ECECEC</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="Theme.ChatGPTCustom" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:statusBarColor">@color/bg_surface</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
        <item name="colorPrimary">@color/brand_green</item>
        <item name="colorSurface">@color/bg_surface</item>
    </style>
</resources>