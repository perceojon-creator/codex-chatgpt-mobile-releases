<?xml version="1.0" encoding="utf-8"?>
<!--
  Configuración de raíces accesibles vía FileProvider.
  Permite compartir el APK descargado en caché con el instalador del sistema Android
  (evitando el error 'Failed to find configured root that contains ...').
-->
<paths>
    <!-- Caché interna: APK de actualización descargado por AppUpdateManager -->
    <cache-path name="cache_root" path="." />
    <cache-path name="actualizaciones" path="updates/" />
    <!-- Archivos internos y adjuntos -->
    <files-path name="internal_files" path="." />
    <files-path name="adjuntos" path="attachments/" />
    <!-- Almacenamiento externo si aplica -->
    <external-files-path name="ext_files" path="." />
    <external-path name="ext_storage" path="." />
</paths>
