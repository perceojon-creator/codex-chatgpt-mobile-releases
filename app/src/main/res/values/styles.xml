<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ChatGPT Mobile Official Typography Hierarchy -->

    <!-- Main Title / App Bar / Dialog Headings: Söhne -->
    <style name="TextAppearance.ChatGPT.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">17.5sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">@font/soehne</item>
        <item name="android:letterSpacing">-0.015</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.ChatGPT.SectionHeader" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:fontFamily">@font/soehne</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.ChatGPT.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:lineSpacingExtra">3.5dp</item>
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:letterSpacing">-0.005</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.ChatGPT.Subtitle" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12.5sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.ChatGPT.CardTitle" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">@font/soehne</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- Code Blocks / Monospace: Official Menlo -->
    <style name="TextAppearance.ChatGPT.Code" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">11.5sp</item>
        <item name="android:textColor">@color/text_code</item>
        <item name="android:fontFamily">@font/menlo</item>
        <item name="android:lineSpacingExtra">2dp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.ChatGPT.Badge" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">10.5sp</item>
        <item name="android:fontFamily">@font/soehne</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.ChatGPT.Tab" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">@font/soehne</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.ChatGPT.Input" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

</resources>
