<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutChatEmptyState"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:paddingHorizontal="24dp"
    android:paddingVertical="32dp">

    <!-- Centered OpenAI Emblem / Logo -->
    <ImageView
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:srcCompat="@drawable/ic_robot"
        app:tint="@color/brand_green"
        android:background="@drawable/bg_token_chip"
        android:padding="10dp"
        android:layout_marginBottom="16dp" />

    <!-- Official Headline in Söhne -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="¿En qué puedo ayudarte hoy?"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:fontFamily="@font/soehne"
        android:textStyle="bold"
        android:letterSpacing="-0.015"
        android:includeFontPadding="false"
        android:layout_marginBottom="24dp"
        android:gravity="center" />

    <!-- 2x2 Grid of Starter Suggestion Chips -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">

        <LinearLayout
            android:id="@+id/chipCreateImage"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tool_header"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_marginEnd="6dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎨 Crear imagen"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:fontFamily="@font/soehne"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Generar con IA visual"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:fontFamily="@font/inter_regular"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/chipWebSearch"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tool_header"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_marginStart="6dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔍 Buscar en la web"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:fontFamily="@font/soehne"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Información en tiempo real"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:fontFamily="@font/inter_regular"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/chipWriteCode"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tool_header"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_marginEnd="6dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💻 Escribir código"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:fontFamily="@font/soehne"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Scripts, debug y apps"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:fontFamily="@font/inter_regular"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/chipBrainstorm"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tool_header"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_marginStart="6dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💡 Lluvia de ideas"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:fontFamily="@font/soehne"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Estrategias y planes"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:fontFamily="@font/inter_regular"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
