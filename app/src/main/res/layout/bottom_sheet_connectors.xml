<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_surface"
    android:orientation="vertical"
    android:paddingBottom="32dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="38dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="14dp"
        android:background="#444444" />

    <!-- Sheet Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:layout_marginBottom="16dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Conectores IA"
            android:textColor="@color/text_primary"
            android:textSize="17.5sp"
            android:fontFamily="@font/soehne"
            android:textStyle="bold"
            android:letterSpacing="-0.015"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/tvConnectorStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🟢 Activo"
            android:textColor="#7EE787"
            android:textSize="11sp"
            android:fontFamily="@font/menlo"
            android:textStyle="bold"
            android:background="#1B2D20"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:includeFontPadding="false" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp">

        <!-- Tarjeta 1: Google Flow (Imagen 3.1 & Veo) con Switch ON/OFF -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardConnectorGoogleFlow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#1A241F"
            app:strokeColor="#10A37F"
            app:strokeWidth="1.5dp"
            app:cardCornerRadius="16dp"
            android:layout_marginBottom="12dp"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:text="🎨"
                    android:textSize="22sp"
                    android:gravity="center"
                    android:background="@drawable/bg_token_chip"
                    android:layout_marginEnd="14dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Google Flow"
                            android:textColor="#7EE787"
                            android:textSize="15.5sp"
                            android:fontFamily="@font/soehne"
                            android:textStyle="bold"
                            android:includeFontPadding="false" />

                        <TextView
                            android:id="@+id/tvGoogleFlowStatusBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ACTIVO"
                            android:textColor="#10A37F"
                            android:textSize="9.5sp"
                            android:fontFamily="@font/soehne"
                            android:textStyle="bold"
                            android:background="#1B3E2B"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="2dp"
                            android:layout_marginStart="8dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvGoogleFlowSubDesc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Generación de imágenes y videos"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:fontFamily="@font/inter_regular"
                        android:includeFontPadding="false"
                        android:layout_marginTop="3dp" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchGoogleFlowActive"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    app:thumbTint="@color/brand_green"
                    app:trackTint="#2D3F35"
                    android:contentDescription="Activar o desactivar conector Google Flow" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Tarjeta 2: GitHub Nativo (Repositorios & Código) con Switch ON/OFF -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardConnectorGitHub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#191F2B"
            app:strokeColor="#38BDF8"
            app:strokeWidth="1.5dp"
            app:cardCornerRadius="16dp"
            android:layout_marginBottom="16dp"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:text="🐙"
                    android:textSize="22sp"
                    android:gravity="center"
                    android:background="@drawable/bg_token_chip"
                    android:layout_marginEnd="14dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="GitHub"
                            android:textColor="#38BDF8"
                            android:textSize="15.5sp"
                            android:fontFamily="@font/soehne"
                            android:textStyle="bold"
                            android:includeFontPadding="false" />

                        <TextView
                            android:id="@+id/tvGitHubStatusBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="INACTIVO"
                            android:textColor="@color/text_secondary"
                            android:textSize="9.5sp"
                            android:fontFamily="@font/soehne"
                            android:textStyle="bold"
                            android:background="#262626"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="2dp"
                            android:layout_marginStart="8dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvGitHubSubDesc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Repositorios, ramas, código e issues nativos"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:fontFamily="@font/inter_regular"
                        android:includeFontPadding="false"
                        android:layout_marginTop="3dp" />

                    <TextView
                        android:id="@+id/btnConnectGitHubToken"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔑 Conectar cuenta de GitHub"
                        android:textColor="#38BDF8"
                        android:textSize="11sp"
                        android:fontFamily="@font/soehne"
                        android:textStyle="bold"
                        android:background="@drawable/bg_token_chip"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:layout_marginTop="6dp"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchGitHubActive"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    app:thumbTint="#38BDF8"
                    app:trackTint="#1E293B"
                    android:contentDescription="Activar o desactivar conector GitHub" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Tarjeta de Créditos Totales en Tiempo Real (Limpia y Compacta) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_sheet_tile"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="CRÉDITOS DISPONIBLES"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:fontFamily="@font/soehne"
                    android:letterSpacing="0.08"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/btnRefreshCredits"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔄 Actualizar"
                    android:textColor="#38BDF8"
                    android:textSize="12sp"
                    android:fontFamily="@font/soehne"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <!-- Valor numérico destacado -->
            <TextView
                android:id="@+id/tvLiveCreditsValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1,050 / 1,050 cr"
                android:textColor="#7EE787"
                android:textSize="26sp"
                android:fontFamily="@font/menlo"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:layout_marginBottom="6dp" />

            <!-- Subtítulo de cuenta y estado -->
            <TextView
                android:id="@+id/tvLiveCreditsAccount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cuenta: Google Flow Relay"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:fontFamily="@font/inter_regular"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/tvLiveCreditsStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🟢 Sincronizado en tiempo real"
                android:textColor="#7EE787"
                android:textSize="11.5sp"
                android:fontFamily="@font/inter_regular"
                android:includeFontPadding="false"
                android:layout_marginTop="4dp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
