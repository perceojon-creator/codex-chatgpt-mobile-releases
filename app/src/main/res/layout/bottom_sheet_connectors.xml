<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#1E1E1E"
    android:orientation="vertical"
    android:paddingBottom="24dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="12dp"
        android:background="#3E3E3E" />

    <!-- Sheet Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🔌 Conectores IA"
            android:textColor="#ECECEC"
            android:textSize="17sp"
            android:fontFamily="@font/inter_semibold"
            android:textStyle="bold"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/tvConnectorStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🟢 Google Flow Activo"
            android:textColor="#7EE787"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:background="#1B2D20"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:includeFontPadding="false" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Conectores multimedia para generación de imágenes y videos en el chat"
        android:textColor="#888888"
        android:textSize="12sp"
        android:fontFamily="@font/inter_regular"
        android:paddingHorizontal="20dp"
        android:layout_marginBottom="12dp"
        android:includeFontPadding="false" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="580dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">

            <!-- SELECTOR DE CONECTOR -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CONECTOR SELECCIONADO"
                android:textColor="#8E8E8E"
                android:textSize="10sp"
                android:fontFamily="@font/inter_semibold"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:includeFontPadding="false"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <!-- Google Flow (Active Connector) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardConnectorGoogleFlow"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:cardBackgroundColor="#222B25"
                    app:strokeColor="#10A37F"
                    app:strokeWidth="1.5dp"
                    app:cardCornerRadius="10dp"
                    android:layout_marginEnd="6dp"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⚡ Google Flow"
                            android:textColor="#7EE787"
                            android:textSize="13sp"
                            android:fontFamily="@font/inter_semibold"
                            android:textStyle="bold"
                            android:includeFontPadding="false" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Imagen 3.1 &amp; Veo 3.1"
                            android:textColor="#A0A0A0"
                            android:textSize="11sp"
                            android:fontFamily="@font/inter_regular"
                            android:includeFontPadding="false" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Próximos Conectores (Extensible) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardConnectorMore"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:cardBackgroundColor="#232323"
                    app:strokeColor="#333333"
                    app:strokeWidth="1dp"
                    app:cardCornerRadius="10dp"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="➕ Más Conectores"
                            android:textColor="#8E8E8E"
                            android:textSize="13sp"
                            android:fontFamily="@font/inter_semibold"
                            android:textStyle="bold"
                            android:includeFontPadding="false" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="OpenAI, Sora, Fal..."
                            android:textColor="#666666"
                            android:textSize="11sp"
                            android:fontFamily="@font/inter_regular"
                            android:includeFontPadding="false" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- CONFIG SUMMARY CARD -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#252528"
                app:strokeColor="#383838"
                app:strokeWidth="1dp"
                app:cardCornerRadius="10dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PARÁMETROS DEL CONECTOR GOOGLE FLOW"
                        android:textColor="#8E8E8E"
                        android:textSize="10sp"
                        android:fontFamily="@font/inter_semibold"
                        android:textStyle="bold"
                        android:letterSpacing="0.06"
                        android:includeFontPadding="false"
                        android:layout_marginBottom="6dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvConnectorEndpointInfo"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Google Flow: http://127.0.0.1:8317/v1 • Key: proxy-pool"
                            android:textColor="#A0A0A0"
                            android:textSize="11sp"
                            android:fontFamily="monospace"
                            android:singleLine="true"
                            android:ellipsize="middle" />

                        <TextView
                            android:id="@+id/btnEditConnectorConfig"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Editar ▾"
                            android:textColor="#10A37F"
                            android:textSize="11sp"
                            android:fontFamily="@font/inter_semibold"
                            android:textStyle="bold"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="3dp"
                            android:clickable="true"
                            android:focusable="true" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SECTION 1: GENERADOR DE IMÁGENES (GOOGLE FLOW) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GOOGLE FLOW • IMÁGENES (/v1/images/generations)"
                android:textColor="#8E8E8E"
                android:textSize="11sp"
                android:fontFamily="@font/inter_semibold"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:includeFontPadding="false"
                android:layout_marginBottom="6dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#262626"
                app:strokeColor="#383838"
                app:strokeWidth="1dp"
                app:cardCornerRadius="12dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🎨"
                            android:textSize="20sp"
                            android:layout_marginEnd="10dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Google Flow: Imagen 3.1"
                                android:textColor="#ECECEC"
                                android:textSize="14sp"
                                android:fontFamily="@font/inter_semibold"
                                android:textStyle="bold"
                                android:includeFontPadding="false" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Motor Google Flow / Imagen 3.1 / ImageFX"
                                android:textColor="#888888"
                                android:textSize="11sp"
                                android:fontFamily="@font/inter_regular"
                                android:includeFontPadding="false" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Model chips -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:id="@+id/chipModelImagen31"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="imagen-3.1"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:fontFamily="monospace"
                            android:background="#10A37F"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="5dp"
                            android:layout_marginEnd="6dp"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/chipModelImagen3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="imagen-3"
                            android:textColor="#A0A0A0"
                            android:textSize="11sp"
                            android:fontFamily="monospace"
                            android:background="#333333"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="5dp"
                            android:layout_marginEnd="6dp"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/chipModelImagefx"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="imagefx"
                            android:textColor="#A0A0A0"
                            android:textSize="11sp"
                            android:fontFamily="monospace"
                            android:background="#333333"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="5dp"
                            android:clickable="true"
                            android:focusable="true" />
                    </LinearLayout>

                    <!-- Prompt EditText -->
                    <EditText
                        android:id="@+id/etImagePrompt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#1E1E1E"
                        android:textColor="#ECECEC"
                        android:textColorHint="#6E6E6E"
                        android:hint="Escribe qué deseas generar (ej. un mono bailando)"
                        android:textSize="13sp"
                        android:padding="12dp"
                        android:minLines="2"
                        android:gravity="top|start"
                        android:layout_marginBottom="8dp" />

                    <!-- Quick suggestion chips -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:id="@+id/btnQuickMonkey"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🐒 un mono bailando"
                            android:textColor="#79C0FF"
                            android:textSize="11sp"
                            android:background="#1E2838"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"
                            android:layout_marginEnd="6dp"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/btnQuickCyberpunk"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🚀 astronauta cyberpunk"
                            android:textColor="#A0A0A0"
                            android:textSize="11sp"
                            android:background="#2E2E2E"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"
                            android:clickable="true"
                            android:focusable="true" />
                    </LinearLayout>

                    <!-- Action buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnGenerateImageNow"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_weight="1"
                            android:text="🎨 Generar Imagen"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:backgroundTint="#10A37F"
                            app:cornerRadius="8dp"
                            android:layout_marginEnd="6dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnActivateImageConnector"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_weight="1"
                            android:text="⚡ Activar en Chat"
                            android:textColor="#ECECEC"
                            android:textSize="12sp"
                            app:backgroundTint="#333333"
                            app:cornerRadius="8dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SECTION 2: GENERADOR DE VIDEOS (GOOGLE FLOW) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GOOGLE FLOW • VIDEOS (/v1/videos/generations)"
                android:textColor="#8E8E8E"
                android:textSize="11sp"
                android:fontFamily="@font/inter_semibold"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:includeFontPadding="false"
                android:layout_marginBottom="6dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#262626"
                app:strokeColor="#383838"
                app:strokeWidth="1dp"
                app:cardCornerRadius="12dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🎬"
                            android:textSize="20sp"
                            android:layout_marginEnd="10dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Google Flow: Veo 3.1"
                                android:textColor="#ECECEC"
                                android:textSize="14sp"
                                android:fontFamily="@font/inter_semibold"
                                android:textStyle="bold"
                                android:includeFontPadding="false" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Motor Google Flow / Veo 3.1 / VideoFX"
                                android:textColor="#888888"
                                android:textSize="11sp"
                                android:fontFamily="@font/inter_regular"
                                android:includeFontPadding="false" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Model chips -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:id="@+id/chipModelVeo31"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="veo-3.1"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:fontFamily="monospace"
                            android:background="#D19A66"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="5dp"
                            android:layout_marginEnd="6dp"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/chipModelVeo2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="veo-2"
                            android:textColor="#A0A0A0"
                            android:textSize="11sp"
                            android:fontFamily="monospace"
                            android:background="#333333"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="5dp"
                            android:layout_marginEnd="6dp"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/chipModelVideofx"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="videofx"
                            android:textColor="#A0A0A0"
                            android:textSize="11sp"
                            android:fontFamily="monospace"
                            android:background="#333333"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="5dp"
                            android:clickable="true"
                            android:focusable="true" />
                    </LinearLayout>

                    <!-- Prompt EditText -->
                    <EditText
                        android:id="@+id/etVideoPrompt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#1E1E1E"
                        android:textColor="#ECECEC"
                        android:textColorHint="#6E6E6E"
                        android:hint="Escribe qué video deseas generar (ej. un mono bailando salsa)"
                        android:textSize="13sp"
                        android:padding="12dp"
                        android:minLines="2"
                        android:gravity="top|start"
                        android:layout_marginBottom="12dp" />

                    <!-- Action buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnGenerateVideoNow"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_weight="1"
                            android:text="🎬 Generar Video"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:backgroundTint="#D19A66"
                            app:cornerRadius="8dp"
                            android:layout_marginEnd="6dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnActivateVideoConnector"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_weight="1"
                            android:text="⚡ Activar en Chat"
                            android:textColor="#ECECEC"
                            android:textSize="12sp"
                            app:backgroundTint="#333333"
                            app:cornerRadius="8dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
