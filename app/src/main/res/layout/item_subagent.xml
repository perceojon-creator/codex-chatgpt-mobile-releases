<?xml version="1.0" encoding="utf-8"?>
<LinearLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="8dp"
    android:paddingHorizontal="6dp"
    android:background="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvSubagentIcon"
            android:layout_width="32dp"
            android:layout_height="wrap_content"
            android:text="🏛️"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/tvSubagentName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="System Architect"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSubagentEffort"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="xHigh"
            android:textColor="@color/brand_green"
            android:textSize="12sp"
            android:background="#233529"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvSubagentDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:paddingStart="32dp"
        android:paddingTop="2dp"
        android:text="Diseño de sistemas distribuidos y contratos." />
</LinearLayout>
