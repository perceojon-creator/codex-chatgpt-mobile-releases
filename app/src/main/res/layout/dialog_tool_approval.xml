<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header / Risk Indicator -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tvRiskBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚠️ SENSITIVE"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:textColor="#FFFFFF"
            android:background="#D97706"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/tvApprovalTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Petición de ejecución"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="El asistente quiere ejecutar la siguiente herramienta:"
        android:textSize="14sp"
        android:layout_marginBottom="8dp" />

    <!-- Tool Name -->
    <TextView
        android:id="@+id/tvToolName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="tool_name"
        android:typeface="monospace"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#2563EB"
        android:layout_marginBottom="4dp" />

    <!-- Server Name -->
    <TextView
        android:id="@+id/tvServerName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Servidor: ..."
        android:textSize="13sp"
        android:textColor="#6B7280"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Argumentos:"
        android:textStyle="bold"
        android:textSize="13sp"
        android:layout_marginBottom="4dp" />

    <!-- Scrollable JSON arguments -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="160dp"
        android:background="#1E1E1E"
        android:padding="8dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tvArgumentsJson"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="{}"
            android:typeface="monospace"
            android:textSize="12sp"
            android:textColor="#E5E7EB" />
    </ScrollView>

    <!-- Irreversible Warning -->
    <TextView
        android:id="@+id/tvIrreversibleWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⚠️ Esta acción no se puede deshacer."
        android:textColor="#DC2626"
        android:textStyle="bold"
        android:textSize="13sp"
        android:visibility="gone"
        android:layout_marginBottom="16dp" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end">

        <Button
            android:id="@+id/btnApproveSession"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Permitir en esta sesión"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <Button
                android:id="@+id/btnReject"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#DC2626"
                android:text="Rechazar"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnApproveOnce"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Permitir una vez" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
