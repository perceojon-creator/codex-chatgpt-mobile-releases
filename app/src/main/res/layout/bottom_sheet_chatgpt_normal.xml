<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#1E1E1E"
    android:orientation="vertical"
    android:paddingBottom="24dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="14dp"
        android:background="#3E3E3E" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Opciones y Adjuntos"
        android:textColor="#ECECEC"
        android:textSize="16sp"
        android:fontFamily="@font/inter_semibold"
        android:textStyle="bold"
        android:includeFontPadding="false"
        android:paddingHorizontal="20dp"
        android:layout_marginBottom="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp">

        <!-- Attach Document -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/actionNormalAttachDoc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="#262626"
            app:strokeColor="#383838"
            app:strokeWidth="1dp"
            app:cardCornerRadius="12dp"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="14dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📄"
                    android:textSize="20sp"
                    android:layout_marginEnd="14dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Documento o Archivo de Código"
                        android:textColor="#ECECEC"
                        android:textSize="14sp"
                        android:fontFamily="@font/inter_semibold"
                        android:textStyle="bold"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:includeFontPadding="false" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PDF, Python, JavaScript, JSON, Markdown"
                        android:textColor="#888888"
                        android:textSize="12sp"
                        android:fontFamily="@font/inter_regular"
                        android:includeFontPadding="false" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Attach Image -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/actionNormalAttachImage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="#262626"
            app:strokeColor="#383838"
            app:strokeWidth="1dp"
            app:cardCornerRadius="12dp"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="14dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🖼️"
                    android:textSize="20sp"
                    android:layout_marginEnd="14dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Foto o Captura de Pantalla"
                        android:textColor="#ECECEC"
                        android:textSize="14sp"
                        android:fontFamily="@font/inter_semibold"
                        android:textStyle="bold"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:includeFontPadding="false" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PNG, JPG, WebP"
                        android:textColor="#888888"
                        android:textSize="12sp"
                        android:fontFamily="@font/inter_regular"
                        android:includeFontPadding="false" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Web Search -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/actionNormalWebSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="#262626"
            app:strokeColor="#383838"
            app:strokeWidth="1dp"
            app:cardCornerRadius="12dp"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="14dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌐"
                    android:textSize="20sp"
                    android:layout_marginEnd="14dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Búsqueda Web en Vivo"
                        android:textColor="#ECECEC"
                        android:textSize="14sp"
                        android:fontFamily="@font/inter_semibold"
                        android:textStyle="bold"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:includeFontPadding="false" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Consultar información actualizada en internet"
                        android:textColor="#888888"
                        android:textSize="12sp"
                        android:fontFamily="@font/inter_regular"
                        android:includeFontPadding="false" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Cloud Python Execution (E2B - No Local Docker) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/actionNormalCloudPython"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="#262626"
            app:strokeColor="#383838"
            app:strokeWidth="1dp"
            app:cardCornerRadius="12dp"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="14dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🐍"
                    android:textSize="20sp"
                    android:layout_marginEnd="14dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ejecutar Python en la Nube (E2B)"
                        android:textColor="#ECECEC"
                        android:textSize="14sp"
                        android:fontFamily="@font/inter_semibold"
                        android:textStyle="bold"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:includeFontPadding="false" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sandbox MicroVM cloud - Sin gastar recursos ni Docker en PC"
                        android:textColor="#888888"
                        android:textSize="12sp"
                        android:fontFamily="@font/inter_regular"
                        android:includeFontPadding="false" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Subagent Selection -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/actionNormalSubagents"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="#262626"
            app:strokeColor="#383838"
            app:strokeWidth="1dp"
            app:cardCornerRadius="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="14dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🧭"
                    android:textSize="20sp"
                    android:layout_marginEnd="14dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tienda de Skills (Claude &amp; Codex)"
                        android:textColor="#ECECEC"
                        android:textSize="14sp"
                        android:fontFamily="@font/inter_semibold"
                        android:textStyle="bold"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:includeFontPadding="false" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Habilidades nativas: Systematic Debugging, TDD, Codebase Memory, etc."
                        android:textColor="#888888"
                        android:textSize="12sp"
                        android:fontFamily="@font/inter_regular"
                        android:includeFontPadding="false" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</LinearLayout>
