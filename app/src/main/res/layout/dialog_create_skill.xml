<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#1E1E1E">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="➕ Crear Skill Personalizada"
            android:textColor="#ECECEC"
            android:textSize="17sp"
            android:fontFamily="@font/inter_semibold"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:layout_marginBottom="16dp" />

        <!-- Row: Emoji & Name -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <EditText
                android:id="@+id/etNewSkillEmoji"
                android:layout_width="54dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:background="#292929"
                android:text="⚡"
                android:textSize="20sp"
                android:textColor="#ECECEC"
                android:inputType="text"
                android:maxLength="2"
                android:layout_marginEnd="10dp" />

            <EditText
                android:id="@+id/etNewSkillName"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="#292929"
                android:hint="Nombre de la Skill..."
                android:textColorHint="#6E6E6E"
                android:textColor="#ECECEC"
                android:textSize="14sp"
                android:fontFamily="@font/inter_semibold"
                android:paddingHorizontal="12dp"
                android:singleLine="true"
                android:inputType="textCapWords" />
        </LinearLayout>

        <!-- Category -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CATEGORÍA"
            android:textColor="#888888"
            android:textSize="10sp"
            android:fontFamily="@font/inter_semibold"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etNewSkillCategory"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="#292929"
            android:hint="Ingeniería, Ciberseguridad, Redacción..."
            android:textColorHint="#6E6E6E"
            android:textColor="#ECECEC"
            android:textSize="13sp"
            android:fontFamily="@font/inter_regular"
            android:paddingHorizontal="12dp"
            android:singleLine="true"
            android:layout_marginBottom="12dp" />

        <!-- Description -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DESCRIPCIÓN CORTA"
            android:textColor="#888888"
            android:textSize="10sp"
            android:fontFamily="@font/inter_semibold"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etNewSkillDescription"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="#292929"
            android:hint="Propósito y cuándo debe usarse..."
            android:textColorHint="#6E6E6E"
            android:textColor="#ECECEC"
            android:textSize="13sp"
            android:fontFamily="@font/inter_regular"
            android:paddingHorizontal="12dp"
            android:singleLine="true"
            android:layout_marginBottom="12dp" />

        <!-- System Prompt / Operational Rules -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="INSTRUCCIONES Y REGLAS OPERATIVAS (PROMPT)"
            android:textColor="#888888"
            android:textSize="10sp"
            android:fontFamily="@font/inter_semibold"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etNewSkillPrompt"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:gravity="top|start"
            android:background="#292929"
            android:hint="Define el rol, reglas inquebrantables, metodología y directivas para el modelo..."
            android:textColorHint="#6E6E6E"
            android:textColor="#ECECEC"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:padding="12dp"
            android:inputType="textMultiLine|textCapSentences"
            android:lineSpacingExtra="2dp"
            android:layout_marginBottom="16dp" />

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <TextView
                android:id="@+id/btnCancelNewSkill"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="Cancelar"
                android:textColor="#8E8E8E"
                android:textSize="13sp"
                android:fontFamily="@font/inter_semibold"
                android:paddingHorizontal="16dp"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btnSaveNewSkill"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="Guardar Skill"
                android:textColor="#ECECEC"
                android:textSize="13sp"
                android:fontFamily="@font/inter_semibold"
                android:textStyle="bold"
                android:background="#10A37F"
                android:paddingHorizontal="18dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
