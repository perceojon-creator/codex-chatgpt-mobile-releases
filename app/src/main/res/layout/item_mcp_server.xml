<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#212121"
    android:padding="14dp"
    android:layout_marginBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Icon Emoji Container -->
        <TextView
            android:id="@+id/tvMcpServerIcon"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="#2B2B2B"
            android:gravity="center"
            android:text="📱"
            android:textSize="20sp"
            android:layout_marginEnd="12dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvMcpServerName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Android Device &amp; Telemetry"
                    android:textColor="#ECECEC"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:singleLine="true" />

                <TextView
                    android:id="@+id/tvMcpServerBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NATIVO"
                    android:textColor="#10A37F"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:background="#152B20"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:layout_marginStart="6dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvMcpServerDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Telemetría de hardware, batería, memoria RAM y almacenamiento"
                android:textColor="#A0A0A0"
                android:textSize="12sp"
                android:fontFamily="sans-serif"
                android:maxLines="2"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Toggle Switch -->
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchMcpServer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/tvMcpToolsCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡ 3 herramientas disponibles"
            android:textColor="#79C0FF"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btnViewMcpTools"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ver herramientas ›"
            android:textColor="#888888"
            android:textSize="11sp"
            android:fontFamily="sans-serif"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

</LinearLayout>
