<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#1E1E1E"
    android:orientation="vertical"
    android:paddingBottom="24dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="12dp"
        android:background="#3E3E3E" />

    <!-- Sheet Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:layout_marginBottom="12dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="➕ Herramientas y Control de Codex"
            android:textColor="#ECECEC"
            android:textSize="16sp"
            android:fontFamily="@font/inter_semibold"
            android:textStyle="bold"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/tvSheetActiveCwd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📁 Desktop"
            android:textColor="#79C0FF"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:background="#222D3D"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:singleLine="true"
            android:includeFontPadding="false" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="520dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">

            <!-- SECTION 1: UBICACION / CWD EN PC -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="UBICACIÓN DE TRABAJO EN TU PC (CWD)"
                android:textColor="#8E8E8E"
                android:textSize="11sp"
                android:fontFamily="@font/inter_semibold"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginBottom="6dp"
                android:includeFontPadding="false" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/actionChangeCwd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="#262626"
                app:strokeColor="#383838"
                app:strokeWidth="1dp"
                app:cardCornerRadius="10dp"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📁"
                        android:textSize="20sp"
                        android:layout_marginEnd="12dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Elegir Carpeta del Proyecto en tu PC"
                            android:textColor="#ECECEC"
                            android:textSize="14sp"
                            android:fontFamily="@font/inter_semibold"
                            android:textStyle="bold"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:includeFontPadding="false" />

                        <TextView
                            android:id="@+id/tvCwdSubtext"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="C:\Users\Admin\Desktop\..."
                            android:textColor="#79C0FF"
                            android:textSize="12sp"
                            android:fontFamily="monospace"
                            android:singleLine="true"
                            android:ellipsize="middle"
                            android:includeFontPadding="false" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cambiar ▾"
                        android:textColor="#10A37F"
                        android:textSize="12sp"
                        android:fontFamily="@font/inter_semibold"
                        android:textStyle="bold"
                        android:includeFontPadding="false" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ACTION: Tienda de Skills (Claude & Codex) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/actionCodexSkillStore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="#262626"
                app:strokeColor="#383838"
                app:strokeWidth="1dp"
                app:cardCornerRadius="10dp"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🧭"
                        android:textSize="20sp"
                        android:layout_marginEnd="12dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tienda de Skills (Claude &amp; Codex)"
                            android:textColor="#ECECEC"
                            android:textSize="14sp"
                            android:fontFamily="@font/inter_semibold"
                            android:textStyle="bold"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:includeFontPadding="false" />

                        <TextView
                            android:id="@+id/tvActiveSkillSubtext"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Habilidades nativas activas o disponibles"
                            android:textColor="#888888"
                            android:textSize="12sp"
                            android:fontFamily="@font/inter_regular"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:includeFontPadding="false" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Abrir ▾"
                        android:textColor="#10A37F"
                        android:textSize="12sp"
                        android:fontFamily="@font/inter_semibold"
                        android:textStyle="bold"
                        android:includeFontPadding="false" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ACTION: Servidores MCP Nativos -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/actionMcpManager"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="#262626"
                app:strokeColor="#383838"
                app:strokeWidth="1dp"
                app:cardCornerRadius="10dp"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔌"
                        android:textSize="20sp"
                        android:layout_marginEnd="12dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Servidores MCP Nativos (Local)"
                            android:textColor="#ECECEC"
                            android:textSize="14sp"
                            android:fontFamily="@font/inter_semibold"
                            android:textStyle="bold"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:includeFontPadding="false" />

                        <TextView
                            android:id="@+id/tvMcpActionsSubtext"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="6 servidores nativos (Batería, Memoria, Archivos, Red)"
                            android:textColor="#79C0FF"
                            android:textSize="12sp"
                            android:fontFamily="@font/inter_regular"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:includeFontPadding="false" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Configurar ▾"
                        android:textColor="#10A37F"
                        android:textSize="12sp"
                        android:fontFamily="@font/inter_semibold"
                        android:textStyle="bold"
                        android:includeFontPadding="false" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SECTION 2: PERMISOS DE SANDBOX Y SEGURIDAD -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PERMISOS DE EJECUCIÓN (SANDBOX POLICY)"
                android:textColor="#8E8E8E"
                android:textSize="11sp"
                android:fontFamily="@font/inter_semibold"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginBottom="6dp"
                android:includeFontPadding="false" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="14dp">

                <!-- Full Access Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/actionPermDanger"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="#262626"
                    app:strokeColor="#FF7B72"
                    app:strokeWidth="1dp"
                    app:cardCornerRadius="8dp"
                    android:layout_marginEnd="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="6dp"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🔴 Full Access"
                            android:textColor="#FF7B72"
                            android:textSize="11sp"
                            android:fontFamily="@font/inter_semibold"
                            android:textStyle="bold"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:includeFontPadding="false" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Terminal total"
                            android:textColor="#888888"
                            android:textSize="10sp"
                            android:fontFamily="@font/inter_regular"
                            android:singleLine="true"
                            android:includeFontPadding="false" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Workspace Only Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/actionPermWorkspace"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="#262626"
                    app:strokeColor="#383838"
                    app:strokeWidth="1dp"
                    app:cardCornerRadius="8dp"
                    android:layout_marginHorizontal="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="6dp"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🟡 Workspace"
                            android:textColor="#E3B341"
                            android:textSize="11sp"
                            android:fontFamily="@font/inter_semibold"
                            android:textStyle="bold"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:includeFontPadding="false" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Solo carpeta"
                            android:textColor="#888888"
                            android:textSize="10sp"
                            android:fontFamily="@font/inter_regular"
                            android:singleLine="true"
                            android:includeFontPadding="false" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Read Only Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/actionPermReadonly"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="#262626"
                    app:strokeColor="#383838"
                    app:strokeWidth="1dp"
                    app:cardCornerRadius="8dp"
                    android:layout_marginStart="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="6dp"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🟢 Solo Lectura"
                            android:textColor="#7EE787"
                            android:textSize="11sp"
                            android:fontFamily="@font/inter_semibold"
                            android:textStyle="bold"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:includeFontPadding="false" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sin cambios"
                            android:textColor="#888888"
                            android:textSize="10sp"
                            android:fontFamily="@font/inter_regular"
                            android:singleLine="true"
                            android:includeFontPadding="false" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- SECTION 3: ARCHIVOS Y ADJUNTOS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ADJUNTAR Y BÚSQUEDA"
                android:textColor="#8E8E8E"
                android:textSize="11sp"
                android:fontFamily="@font/inter_semibold"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginBottom="6dp"
                android:includeFontPadding="false" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="14dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/actionAttachDoc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="#262626"
                    app:strokeColor="#383838"
                    app:strokeWidth="1dp"
                    app:cardCornerRadius="10dp"
                    android:layout_marginEnd="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="8dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📄"
                            android:textSize="16sp"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Archivo"
                            android:textColor="#ECECEC"
                            android:textSize="11sp"
                            android:fontFamily="@font/inter_semibold"
                            android:textStyle="bold"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:includeFontPadding="false" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/actionAttachImage"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="#262626"
                    app:strokeColor="#383838"
                    app:strokeWidth="1dp"
                    app:cardCornerRadius="10dp"
                    android:layout_marginHorizontal="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="8dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🖼️"
                            android:textSize="16sp"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Foto"
                            android:textColor="#ECECEC"
                            android:textSize="11sp"
                            android:fontFamily="@font/inter_semibold"
                            android:textStyle="bold"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:includeFontPadding="false" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/actionWebSearch"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="#262626"
                    app:strokeColor="#383838"
                    app:strokeWidth="1dp"
                    app:cardCornerRadius="10dp"
                    android:layout_marginStart="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="8dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🌐"
                            android:textSize="16sp"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Web"
                            android:textColor="#ECECEC"
                            android:textSize="11sp"
                            android:fontFamily="@font/inter_semibold"
                            android:textStyle="bold"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:includeFontPadding="false" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- SECTION 4: HABILIDADES Y SUPERPODERES DE CODEX -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HABILIDADES Y SUPERPODERES DE CODEX (SKILLS)"
                android:textColor="#8E8E8E"
                android:textSize="11sp"
                android:fontFamily="@font/inter_semibold"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginBottom="6dp"
                android:includeFontPadding="false" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/actionSkillTdd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="#262626"
                app:strokeColor="#383838"
                app:strokeWidth="1dp"
                app:cardCornerRadius="10dp"
                android:layout_marginBottom="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="10dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🧪"
                        android:textSize="18sp"
                        android:layout_marginEnd="10dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Test-Driven Development (TDD)"
                            android:textColor="#ECECEC"
                            android:textSize="14sp"
                            android:fontFamily="@font/inter_semibold"
                            android:textStyle="bold"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:includeFontPadding="false" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Escribir pruebas que fallen primero y verificar cobertura"
                            android:textColor="#888888"
                            android:textSize="12sp"
                            android:fontFamily="@font/inter_regular"
                            android:includeFontPadding="false" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/actionSkillDebugging"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="#262626"
                app:strokeColor="#383838"
                app:strokeWidth="1dp"
                app:cardCornerRadius="10dp"
                android:layout_marginBottom="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="10dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔍"
                        android:textSize="18sp"
                        android:layout_marginEnd="10dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Systematic Debugging"
                            android:textColor="#ECECEC"
                            android:textSize="14sp"
                            android:fontFamily="@font/inter_semibold"
                            android:textStyle="bold"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:includeFontPadding="false" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Aislar la causa raíz con logs antes de parchar"
                            android:textColor="#888888"
                            android:textSize="12sp"
                            android:fontFamily="@font/inter_regular"
                            android:includeFontPadding="false" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/actionSkillPlans"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="#262626"
                app:strokeColor="#383838"
                app:strokeWidth="1dp"
                app:cardCornerRadius="10dp"
                android:layout_marginBottom="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="10dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🏛️"
                        android:textSize="18sp"
                        android:layout_marginEnd="10dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Writing Architecture Plans"
                            android:textColor="#ECECEC"
                            android:textSize="14sp"
                            android:fontFamily="@font/inter_semibold"
                            android:textStyle="bold"
                            android:singleLine="true"
                            android:ellipsize="end"
