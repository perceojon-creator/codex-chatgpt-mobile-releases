<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#171717"
    android:padding="16dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:background="#3E3E3E"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp" />

    <!-- Top Header: Title & Model Context Window Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSheetTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📊 Métricas de Contexto y Tokens"
                android:textColor="#ECECEC"
                android:textSize="18sp"
                android:fontFamily="@font/inter_semibold"
                android:textStyle="bold"
                android:singleLine="true" />

            <TextView
                android:id="@+id/tvSheetSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Consumo activo en la ventana de contexto del modelo"
                android:textColor="#888888"
                android:textSize="12sp"
                android:fontFamily="@font/inter_regular"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Max Window Badge -->
        <TextView
            android:id="@+id/tvContextWindowMaxBadge"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="128k Máx"
            android:textColor="#10A37F"
            android:textSize="12sp"
            android:fontFamily="@font/inter_semibold"
            android:textStyle="bold"
            android:background="@drawable/bg_metrics_badge"
            android:paddingHorizontal="10dp" />
    </LinearLayout>

    <!-- Main Total Context Saturation Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#212121"
        android:padding="14dp"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvTotalUsedTokensNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="7.829"
                android:textColor="#ECECEC"
                android:textSize="26sp"
                android:fontFamily="@font/inter_semibold"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTotalLimitSuffix"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text=" / 128.000 tokens"
                android:textColor="#888888"
                android:textSize="14sp"
                android:fontFamily="@font/inter_regular"
                android:layout_marginStart="6dp" />

            <TextView
                android:id="@+id/tvContextPercentUsed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="6.1%"
                android:textColor="#10A37F"
                android:textSize="16sp"
                android:fontFamily="@font/inter_semibold"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/pbContextProgress"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="6dp"
            android:max="100"
            android:progress="6"
            android:progressTint="#10A37F"
            android:progressBackgroundTint="#333333" />

        <TextView
            android:id="@+id/tvTokensRemaining"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tokens libres para respuestas: 120.171 tokens"
            android:textColor="#AAAAAA"
            android:textSize="11sp"
            android:fontFamily="@font/inter_regular" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DESGLOSE POR CATEGORÍA"
        android:textColor="#777777"
        android:textSize="11sp"
        android:textStyle="bold"
        android:fontFamily="@font/inter_semibold"
        android:letterSpacing="0.06"
        android:layout_marginBottom="8dp" />

    <!-- 4 Divided Breakdown Items -->

    <!-- 1. System Prompt -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#212121"
        android:padding="12dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="🤖"
            android:textSize="18sp"
            android:background="#2A2A2A" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="System Prompt"
                android:textColor="#ECECEC"
                android:textSize="14sp"
                android:fontFamily="@font/inter_semibold"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSystemPromptDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reglas de 3 niveles, CaMeL anti-inyección, E2B, Skill activo"
                android:textColor="#888888"
                android:textSize="11sp"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSystemPromptTokens"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3.849"
            android:textColor="#38BDF8"
            android:textSize="15sp"
            android:fontFamily="@font/inter_semibold"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 2. Herramientas MCP (Tools) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#212121"
        android:padding="12dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="🔧"
            android:textSize="18sp"
            android:background="#2A2A2A" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Herramientas MCP (Tools)"
                android:textColor="#ECECEC"
                android:textSize="14sp"
                android:fontFamily="@font/inter_semibold"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvToolsDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="50 esquemas nativos + ejecuciones y respuestas"
                android:textColor="#888888"
                android:textSize="11sp"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvToolsTokens"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3.980"
            android:textColor="#A78BFA"
            android:textSize="15sp"
            android:fontFamily="@font/inter_semibold"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 3. Mensajes del Usuario -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#212121"
        android:padding="12dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="👤"
            android:textSize="18sp"
            android:background="#2A2A2A" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mensajes del Usuario (Tú)"
                android:textColor="#ECECEC"
                android:textSize="14sp"
                android:fontFamily="@font/inter_semibold"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvUserMessagesDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 mensajes en esta conversación"
                android:textColor="#888888"
                android:textSize="11sp"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvUserMessagesTokens"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="#34D399"
            android:textSize="15sp"
            android:fontFamily="@font/inter_semibold"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 4. Respuestas del Modelo (Asistente) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#212121"
        android:padding="12dp"
        android:layout_marginBottom="14dp">

        <TextView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="💬"
            android:textSize="18sp"
            android:background="#2A2A2A" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Respuestas del Asistente"
                android:textColor="#ECECEC"
                android:textSize="14sp"
                android:fontFamily="@font/inter_semibold"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAssistantDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 respuestas generadas (texto + razonamiento)"
                android:textColor="#888888"
                android:textSize="11sp"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvAssistantTokens"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="#FBBF24"
            android:textSize="15sp"
            android:fontFamily="@font/inter_semibold"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Compaction Button (Apex DSH Context Compaction) -->
    <Button
        android:id="@+id/btnCompactContext"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="10dp"
        android:text="📦 Compactar Contexto (Apex DSH)"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:fontFamily="@font/inter_semibold"
        android:backgroundTint="#2563EB" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCopyTokenReport"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:text="📋 Copiar Reporte"
            android:textColor="#ECECEC"
            android:textSize="13sp"
            android:fontFamily="@font/inter_semibold"
            android:backgroundTint="#2D2D2D"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnCloseTokenSheet"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:text="Cerrar"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:fontFamily="@font/inter_semibold"
            android:backgroundTint="#10A37F" />
    </LinearLayout>

</LinearLayout>
