<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_surface"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header Handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@color/border_color" />

    <!-- Title & Icon -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🤖"
            android:textSize="24sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="@string/agent_mode_label"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Opera tu dispositivo Android de forma autónoma usando visión multimodal y accesibilidad (sin cables ni PC)."
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <!-- Goal Input Field -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_agent_goal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:boxBackgroundColor="@color/bg_surface_light"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusTopStart="12dp"
        app:boxStrokeColor="@color/brand_green"
        app:hintTextColor="@color/brand_green">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_agent_goal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:hint="@string/agent_goal_hint"
            android:inputType="textMultiLine|textCapSentences"
            android:lines="3"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Model Selector Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/agent_model_label"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- 3 Proxy Supported Models -->
    <RadioGroup
        android:id="@+id/rg_model_selector"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp">

        <RadioButton
            android:id="@+id/rb_gemini_38"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Gemini 3.8 Flash (Recomendado — Alta velocidad y visión nativa)"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <RadioButton
            android:id="@+id/rb_claude_37"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Claude 3.7 Sonnet (Thinking y máximo razonamiento visual)"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <RadioButton
            android:id="@+id/rb_glm_53"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GLM 5.3 Flash (Bajo consumo de tokens)"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />
    </RadioGroup>

    <!-- Reasoning Effort Selector (Thinking Level) -->
    <LinearLayout
        android:id="@+id/layout_effort_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@color/bg_surface_light"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Nivel de Razonamiento (Thinking Effort)"
                android:textColor="@color/brand_green"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_effort_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_token_chip"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="MEDIUM"
                android:textColor="@color/text_primary"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_effort_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Controla los tokens de reflexión antes de ejecutar cada toque en pantalla."
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <RadioGroup
            android:id="@+id/rg_effort_selector"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rb_effort_none"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="None"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <RadioButton
                android:id="@+id/rb_effort_low"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Low"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <RadioButton
                android:id="@+id/rb_effort_medium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checked="true"
                android:text="Med"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <RadioButton
                android:id="@+id/rb_effort_high"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="High"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />
        </RadioGroup>
    </LinearLayout>

    <!-- Launch Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_launch_agent"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="18dp"
        android:backgroundTint="@color/brand_green"
        android:text="@string/agent_launch_button"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        app:cornerRadius="12dp"
        app:icon="@android:drawable/ic_media_play"
        app:iconGravity="textStart"
        app:iconSize="18dp"
        app:iconTint="#FFFFFF" />

</LinearLayout>
