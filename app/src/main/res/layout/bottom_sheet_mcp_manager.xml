<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#171717"
    android:padding="16dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:background="#3E3E3E"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp" />

    <!-- Top Header: Title & Stats -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔌 Servidores MCP Nativos"
                android:textColor="#ECECEC"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"
                android:singleLine="true" />

            <TextView
                android:id="@+id/tvMcpSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Model Context Protocol en ejecución local en Android"
                android:textColor="#888888"
                android:textSize="11sp"
                android:fontFamily="sans-serif"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Total Tools Badge -->
        <TextView
            android:id="@+id/tvTotalMcpToolsBadge"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="18 Tools Activas"
            android:textColor="#10A37F"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold"
            android:background="#152B20"
            android:paddingHorizontal="10dp" />
    </LinearLayout>

    <!-- Informative Banner -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#1B2228"
        android:padding="10dp"
        android:layout_marginVertical="8dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💡"
            android:textSize="16sp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Las herramientas MCP se ejecutan localmente en el móvil sin requerir servidor externo. ChatGPT puede invocar la batería, almacenamiento, memoria y utilidades."
            android:textColor="#79C0FF"
            android:textSize="11sp"
            android:fontFamily="sans-serif" />
    </LinearLayout>

    <!-- RecyclerView for MCP Servers -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMcpServers"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:clipToPadding="false"
        android:paddingBottom="8dp"
        android:scrollbars="vertical" />

    <!-- Action Buttons: Add Remote Server, MCP Store & Close -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp">

        <TextView
            android:id="@+id/btnOpenMcpCatalog"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🧭 Tienda MCP"
            android:textColor="#79C0FF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:background="#1B2838"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/btnAddRemoteMcpServer"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1.4"
            android:gravity="center"
            android:text="➕ Conectar Remoto"
            android:textColor="#ECECEC"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:background="#262626"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/btnCloseMcpSheet"
            android:layout_width="70dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="Cerrar"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:background="#10A37F"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

</LinearLayout>
