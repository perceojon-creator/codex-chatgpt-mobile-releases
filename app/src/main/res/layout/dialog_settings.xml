<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_surface">

    <LinearLayout 
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚙ Ajustes de Conexión"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:fontFamily="@font/inter_semibold"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:layout_marginBottom="16dp" />

        <!-- Perfil Conectado Actualmente -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E293B"
            android:padding="14dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌐 Proveedor Activo Conectado:"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:fontFamily="@font/inter_semibold"
                android:includeFontPadding="false"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvConnectedProfileName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cargando proveedor…"
                android:textColor="#38BDF8"
                android:textSize="15sp"
                android:textStyle="bold"
                android:fontFamily="@font/inter_semibold"
                android:includeFontPadding="false"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvProfileStatusBadge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔒 Perfil integrado del sistema"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:fontFamily="@font/inter_regular"
                android:includeFontPadding="false" />
        </LinearLayout>

        <Button
            android:id="@+id/btnSelectProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔄 Cambiar Proveedor"
            android:backgroundTint="#0EA5E9"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:fontFamily="@font/inter_semibold"
            android:includeFontPadding="false"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btnAddCustomProvider"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="➕ Añadir Custom"
                android:backgroundTint="@color/bg_surface_light"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnManageCustomProviders"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="⚙️ Administrar"
                android:backgroundTint="@color/bg_surface_light"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnTestConnection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🧪 Probar Conexión con Proveedor"
            android:backgroundTint="#2E4035"
            android:textColor="@color/brand_green"
            android:textSize="13sp"
            android:fontFamily="@font/inter_semibold"
            android:includeFontPadding="false"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/tvConnectionStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:fontFamily="@font/inter_regular"
            android:includeFontPadding="false"
            android:gravity="center"
            android:visibility="gone"
            android:layout_marginBottom="14dp" />

        <!-- E2B API Key (Opcional) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="E2B Cloud API Key (Opcional - Python Nube):"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:fontFamily="@font/inter_semibold"
            android:includeFontPadding="false" />

        <EditText
            android:id="@+id/etE2bApiKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:hint="Clave predeterminada activa (o escribe una propia)"
            android:inputType="textPassword"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:fontFamily="@font/inter_regular"
            android:includeFontPadding="false"
            android:backgroundTint="@color/border_color"
            android:layout_marginBottom="14dp" />

        <Button
            android:id="@+id/btnOpenMcpSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔌 Servidores MCP (Control Móvil, Memoria…)"
            android:backgroundTint="#152B20"
            android:textColor="#10A37F"
            android:textSize="13sp"
            android:fontFamily="@font/inter_semibold"
            android:includeFontPadding="false"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnCheckUpdates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🚀 Buscar Actualización de la App"
            android:backgroundTint="#262626"
            android:textColor="#ECECEC"
            android:textSize="13sp"
            android:fontFamily="@font/inter_semibold"
            android:includeFontPadding="false"
            android:layout_marginBottom="14dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <Button
                android:id="@+id/btnCancelSettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cerrar"
                android:backgroundTint="@android:color/transparent"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnSaveSettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Guardar y Salir"
                android:backgroundTint="@color/brand_green"
                android:textColor="@android:color/white"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
