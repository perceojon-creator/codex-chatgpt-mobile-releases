<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#1E1E1E"
    android:padding="20dp">

    <!-- Header: Icon, Name & Author -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tvDetailSkillIcon"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:gravity="center"
            android:background="#292929"
            android:text="🔍"
            android:textSize="22sp"
            android:layout_marginEnd="12dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDetailSkillName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Systematic Debugging"
                android:textColor="#ECECEC"
                android:textSize="17sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/tvDetailSkillMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Claude &amp; Codex • Anthropic &amp; OpenAI"
                android:textColor="#10A37F"
                android:textSize="11sp"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvDetailSkillDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#A8A8A8"
        android:textSize="13sp"
        android:fontFamily="sans-serif"
        android:lineSpacingExtra="3dp"
        android:includeFontPadding="false"
        android:layout_marginBottom="12dp"
        android:text="Descripción completa de la habilidad." />

    <!-- Protocol Rules Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PROTOCOLO E INSTRUCCIONES DEL SISTEMA:"
        android:textColor="#888888"
        android:textSize="11sp"
        android:fontFamily="sans-serif-medium"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:includeFontPadding="false"
        android:layout_marginBottom="6dp" />

    <!-- Scrollable Rules Container -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="#151515"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvDetailSkillRules"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#ECECEC"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:lineSpacingExtra="3dp"
            android:text="Instrucciones operativas..." />
    </ScrollView>

    <!-- Bottom Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="16dp">

        <TextView
            android:id="@+id/btnDetailClose"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="Cerrar"
            android:textColor="#8E8E8E"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="16dp"
            android:layout_marginEnd="8dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btnDetailToggle"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="⚡ Activar Skill"
            android:textColor="#ECECEC"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold"
            android:background="#10A37F"
            android:paddingHorizontal="16dp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

</LinearLayout>
